# =============================================================================
# bot-cripto — variáveis de ambiente
#
# 1. Copie este arquivo:            cp .env.example .env
# 2. Restrinja a permissão:         chmod 600 .env
# 3. Preencha os valores abaixo.    NUNCA commite o .env (já está no .gitignore).
#
# O Freqtrade lê qualquer chave do config.json a partir de variáveis no formato
# FREQTRADE__SECAO__CHAVE. Assim os segredos ficam fora do config.json.
# =============================================================================

# ---- Modo de operação ------------------------------------------------------
# true  = dry-run (papel, sem dinheiro real)  <-- PADRÃO. Mantenha até a Fase 4.
# false = LIVE (dinheiro real). Só mude após aprovação explícita das Fases 2 e 3.
FREQTRADE__DRY_RUN=true

# Carteira simulada em dry-run (USDT). Use o mesmo valor do capital de teste real
# para que os números do papel sejam comparáveis com o backtest.
FREQTRADE__DRY_RUN_WALLET=1000

# Estratégia carregada pelo container (arquivo em user_data/strategies/).
# Na Fase 0 usamos PlaceholderStrategy, que NUNCA abre operação: serve só para
# validar Telegram, FreqUI e conexão com a Binance.
FREQTRADE_STRATEGY=PlaceholderStrategy

# ---- Binance (Spot) --------------------------------------------------------
# Crie a chave em: Binance > Perfil > Gerenciamento de API
#   [x] Ativar Leitura
#   [x] Ativar Trading Spot e de Margem  (usaremos APENAS Spot)
#   [ ] Ativar Saques                    (DESLIGADO, sempre)
#   [ ] Ativar Futuros                   (DESLIGADO, sempre)
#   Restringir acesso apenas a IPs confiáveis -> IP fixo da VPS
# Em dry-run a chave pode ficar vazia (o bot usa dados públicos).
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# ---- Telegram --------------------------------------------------------------
# Token: fale com @BotFather -> /newbot
# Chat ID: fale com @userinfobot (ou mande msg ao seu bot e consulte
#          https://api.telegram.org/bot<TOKEN>/getUpdates)
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# ---- FreqUI / API REST (acesso SOMENTE via túnel SSH) ----------------------
# Gere senhas fortes:  openssl rand -base64 24
# Gere o JWT secret:   openssl rand -hex 32
FREQTRADE__API_SERVER__USERNAME=flavio
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
# Token opcional para o health-check externo (n8n) sem usar a senha principal.
FREQTRADE__API_SERVER__WS_TOKEN=

# ---- Sistema ---------------------------------------------------------------
TZ=America/Sao_Paulo
# UID/GID do usuário dono da pasta na VPS (rode `id -u` e `id -g`).
# O container roda como "ftuser" (UID 1000). Se o seu usuário for 1000, mantenha.
FT_UID=1000
FT_GID=1000
